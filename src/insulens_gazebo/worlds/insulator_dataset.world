<?xml version="1.0"?>
<sdf version="1.6">
  <world name="insulator_dataset">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>30.0</update_rate>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <real_time_update_rate>500</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.55 0.72 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="dataset_camera">
      <static>true</static>
      <pose>0 0 2 0 0 0</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>60</far></clip>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
          </camera>
          <plugin name="dataset_camera_ros" filename="libgazebo_ros_camera.so">
            <ros><namespace>/insulens</namespace></ros>
            <camera_name>camera</camera_name>
            <frame_name>dataset_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://insulator</uri>
      <name>insulator_training</name>
      <pose>5 0 2 0 0 0</pose>
    </include>
    <include>
      <uri>model://transmission_tower</uri>
      <name>dataset_tower</name>
      <pose>14 2 0 0 0 0.25</pose>
    </include>

    <model name="background_structures">
      <static>true</static>
      <link name="structures">
        <visual name="beam_a"><pose>11 -4 3 0 0.35 0</pose><geometry><box><size>0.25 0.25 7</size></box></geometry><material><diffuse>0.42 0.45 0.48 1</diffuse></material></visual>
        <visual name="beam_b"><pose>16 5 4 0 -0.25 0</pose><geometry><box><size>0.3 0.3 9</size></box></geometry><material><diffuse>0.32 0.35 0.38 1</diffuse></material></visual>
        <visual name="terrain_patch"><pose>13 0 0.03 0 0 0</pose><geometry><box><size>20 18 0.05</size></box></geometry><material><ambient>0.16 0.28 0.10 1</ambient><diffuse>0.28 0.48 0.19 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
