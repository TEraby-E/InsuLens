<?xml version="1.0"?>
<sdf version="1.6">
  <model name="inspection_drone">
    <static>false</static>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial><mass>3.0</mass><inertia><ixx>0.2</ixx><iyy>0.2</iyy><izz>0.3</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.8 0.55 0.22</size></box></geometry></collision>
      <visual name="body">
        <geometry><box><size>0.8 0.55 0.22</size></box></geometry>
        <material><ambient>0.04 0.08 0.12 1</ambient><diffuse>0.08 0.25 0.42 1</diffuse></material>
      </visual>
      <visual name="arm_x"><geometry><box><size>1.4 0.07 0.06</size></box></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="arm_y"><geometry><box><size>0.07 1.2 0.06</size></box></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="camera_body"><pose>0 0 -0.20 0 0 0</pose><geometry><box><size>0.24 0.24 0.18</size></box></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <sensor name="inspection_camera" type="camera">
        <pose>0 0 -0.20 0 0 1.570796</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <plugin name="inspection_camera_ros" filename="libgazebo_ros_camera.so">
          <ros><namespace>/insulens</namespace></ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>
    <plugin name="planar_motion" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/insulens</namespace></ros>
      <update_rate>30.0</update_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>

